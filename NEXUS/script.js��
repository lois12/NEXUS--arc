function renderCalendar() {
  fetchNotes().then(() => {
    const g = document.getElementById("calendar-grid");
    if (!g) return;
    g.classList.add("fading");
    setTimeout(() => {
      g.innerHTML = "";
      const mEl = document.getElementById("cal-month-year");
      if (mEl)
        mEl.textContent = new Date(calYear, calMonth)
          .toLocaleString("ru-RU", { month: "long", year: "numeric" })
          .replace(/^\w/, (c) => c.toUpperCase());
      const fd = new Date(calYear, calMonth, 1).getDay();
      const dim = new Date(calYear, calMonth + 1, 0).getDate();
      const off = fd === 0 ? 6 : fd - 1;
      ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"].forEach((d) => {
        const el = document.createElement("div");
        el.className = "calendar-day-header";
        el.textContent = d;
        g.appendChild(el);
      });
      for (let i = 0; i < off; i++)
        g.appendChild(document.createElement("div"));
      const t = new Date();
      const ic = t.getFullYear() === calYear && t.getMonth() === calMonth;
      for (let d = 1; d <= dim; d++) {
        const ds = `${calYear}-${String(calMonth + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
        const el = document.createElement("div");
        el.className = "calendar-day";
        el.textContent = d;
        el.dataset.date = ds;
        el.style.animationDelay = `${d * 0.012}s`;
        if (ic && d === t.getDate()) el.classList.add("today");
        const dow = new Date(calYear, calMonth, d).getDay();
        if (dow === 0 || dow === 6) el.classList.add("is-weekend");
        const evs = notesCache.filter((n) => n.date === ds);
        if (evs.length > 0) {
          el.classList.add("has-event");
          el.dataset.tooltip = evs[0].name;
        }
        el.onclick = () => openEventModal(ds);
        g.appendChild(el);
      }
      setTimeout(() => g.classList.remove("fading"), 50);
      renderNextPost();
    }, 150);
  });
}
