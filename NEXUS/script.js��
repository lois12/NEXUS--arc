// 🔹 Отрисовка списка в модалке
function renderResourceModal() {
  if (!resListEl) return;
  resListEl.innerHTML =
    '<div style="text-align:center;color:var(--text-muted);padding:15px">Загрузка...</div>';

  // 🔹 Используем кэш, если он есть, иначе грузим с сервера
  if (resourcesCache.length) {
    drawResourceList(resourcesCache);
  } else {
    fetch(RES_API, {
      headers: { Authorization: "Bearer " + window.nexusAuth?.token },
    })
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((list) => {
        resourcesCache = list; // 🔹 Обновляем кэш
        drawResourceList(list);
      })
      .catch(() => {
        resListEl.innerHTML =
          '<div style="text-align:center;color:var(--neon-red);padding:15px">Ошибка загрузки</div>';
      });
  }
}

// 🔹 Отрисовка списка (вынесена в отдельную функцию для повторного использования)
function drawResourceList(list) {
  resListEl.innerHTML = "";
  if (!list.length) {
    resListEl.innerHTML =
      '<div style="text-align:center;color:var(--text-muted);padding:15px">Пока пусто</div>';
    return;
  }
  list.forEach((r) => {
    const div = document.createElement("div");
    div.className = "res-item";
    // 🔹 Клик по названию открывает ссылку
    div.innerHTML = `
      <a href="${r.url}" target="_blank" class="res-link" title="${r.url}">${r.name}</a>
      <div class="res-actions">
        <button class="res-edit" data-id="${r.id}" title="Редактировать">✎</button>
        <button class="res-del" data-id="${r.id}" title="Удалить">✕</button>
      </div>`;
    resListEl.appendChild(div);
  });

  // 🔹 Обработчики: клик по ссылке, редактирование, удаление
  document.querySelectorAll(".res-link").forEach((link) => {
    link.onclick = (e) => {
      e.stopPropagation();
      window.open(link.href, "_blank");
    };
  });
  document.querySelectorAll(".res-edit").forEach((btn) => {
    btn.onclick = (e) => {
      e.stopPropagation();
      const id = btn.dataset.id;
      const item = resourcesCache.find((x) => x.id === id);
      if (item) {
        editingResourceId = id;
        resNameIn.value = item.name;
        resUrlIn.value = item.url;
        resAddBtn.textContent = "💾 Сохранить";
        resNameIn.focus();
        showToast("Редактирование: " + item.name, "info");
      }
    };
  });
  document.querySelectorAll(".res-del").forEach((btn) => {
    btn.onclick = async (e) => {
      e.preventDefault();
      const id = btn.dataset.id;
      try {
        await fetch(`${RES_API}/${id}`, {
          method: "DELETE",
          headers: { Authorization: "Bearer " + window.nexusAuth?.token },
        });
        // 🔹 Удаляем из кэша и перерисовываем сразу
        resourcesCache = resourcesCache.filter((x) => x.id !== id);
        drawResourceList(resourcesCache);
        showToast("Удалено", "success");
      } catch {
        showToast("Ошибка удаления", "error");
      }
    };
  });
}

// 🔹 Добавление / Сохранение ссылки
resAddBtn?.addEventListener("click", async () => {
  const name = resNameIn.value.trim();
  const url = resUrlIn.value.trim();
  if (!name || !url) return showToast("Заполни оба поля", "warning");

  try {
    if (editingResourceId) {
      // 🔹 РЕЖИМ РЕДАКТИРОВАНИЯ: PATCH запрос
      await fetch(`${RES_API}/${editingResourceId}`, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          Authorization: "Bearer " + window.nexusAuth?.token,
        },
        body: JSON.stringify({ name, url }),
      });
      // 🔹 Обновляем кэш и перерисовываем
      const idx = resourcesCache.findIndex((x) => x.id === editingResourceId);
      if (idx !== -1) {
        resourcesCache[idx] = { ...resourcesCache[idx], name, url };
      }
      showToast("Сохранено", "success");
    } else {
      // 🔹 РЕЖИМ ДОБАВЛЕНИЯ: POST запрос
      const r = await fetch(RES_API, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: "Bearer " + window.nexusAuth?.token,
        },
        body: JSON.stringify({ name, url, page: "all" }),
      });
      const newItem = await r.json();
      // 🔹 МГНОВЕННОЕ ДОБАВЛЕНИЕ: добавляем в кэш и рисуем без перезагрузки
      resourcesCache.push(newItem);
      drawResourceList(resourcesCache);
      showToast("Ссылка добавлена", "success");
    }

    // 🔹 Сброс формы
    resNameIn.value = "";
    resUrlIn.value = "";
    editingResourceId = null;
    resAddBtn.textContent = "+ Добавить";
  } catch (e) {
    showToast("Ошибка: " + e.message, "error");
  }
});

